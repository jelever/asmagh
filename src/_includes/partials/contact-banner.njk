{%- from "macros.njk" import tt -%}
{#- Contact banner: heading, two actions (quote, WhatsApp) and the acacia
    horizon leading into the footer. -#}
<section class="banner" aria-labelledby="banner-title">
  <div class="banner__inner container">
    <h2 class="h3" id="banner-title">{{ tt(t.banner.title) }}</h2>
    <p>{{ t.banner.text }}</p>
    <div class="banner__actions">
      <a class="btn btn--light btn--lg" href="/{{ lang }}/contact/">{% icon "request-quote" %}{{ t.requestQuote }}</a>
      <a class="btn btn--ghost btn--lg" href="https://wa.me/{{ site.contact.whatsapp }}" target="_blank" rel="noopener">{% include "partials/icon-whatsapp.svg" %}{{ t.banner.whatsapp }}</a>
    </div>
  </div>
  <img class="banner__horizon" src="/assets/brand/deco/acacia-horizon-teal.svg" alt="" aria-hidden="true" width="1440" height="240" loading="lazy">
</section>
